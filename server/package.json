{
  "name": "resumecraft-server",
  "version": "1.0.0",
  "description": "ResumeCraft MERN Backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "start": "node --import ./instrument.mjs index.js",
    "migrate:domain": "node scripts/migrate-add-domain.js",
